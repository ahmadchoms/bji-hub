# ==========================================
# BIJI CORP - ENVIRONMENT CONFIGURATION
# ==========================================

# Data Source: "prisma" (production cloud DB) or "mock" (in-memory demo)
DATA_SOURCE="prisma"
# ALLOW_MOCK_AUTH=true  # HANYA untuk deployment demo. Jangan aktifkan di production sungguhan.

# App Public URL
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# ==========================================
# DATABASE (PostgreSQL - Supabase / Neon)
# ==========================================
# Transaction pooler connection string (port 6543 on Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct database connection string for migrations (port 5432 on Supabase)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional: Throwaway database for contract tests (must end with _test)
# TEST_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@localhost:5432/biji_test"

# ==========================================
# MIDTRANS PAYMENT GATEWAY
# ==========================================
# Midtrans Server Key (Keep secret! Never prefix with NEXT_PUBLIC_)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxx"

# Midtrans Client Key (Public for Snap.js popup checkout)
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxx"

# Payment Provider: "midtrans" (default) or "mock"
PAYMENT_PROVIDER="midtrans"

# Set "true" for production, "false" for sandbox
MIDTRANS_IS_PRODUCTION="false"

# ==========================================
# RAJAONGKIR SHIPPING ENGINE
# ==========================================
# API key dari dashboard RajaOngkir (https://rajaongkir.com)
# Jika tidak diisi, sistem otomatis beralih ke Domestic Matrix Fallback (tanpa error).
RAJAONGKIR_API_KEY="your-rajaongkir-api-key"

# Tipe akun RajaOngkir: "starter" (default gratis), "basic", atau "pro"
RAJAONGKIR_ACCOUNT_TYPE="starter"

# ==========================================
# EMAIL NOTIFICATIONS (Resend - Optional)
# ==========================================
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"

# ==========================================
# SUPABASE (Storage & Auth)
# Catatan Google OAuth: Client ID & Client Secret Google dikonfigurasikan di
# Dashboard Supabase (Authentication -> Providers -> Google).
#
# Google Identity Services (One Tap & ID Token - Opsi 1):
# Web Client ID dari Google Cloud Console agar Google consent/prompt menampilkan domain
# bji-hub.vercel.app dan nama "Biji Hub" (bukan domain supabase.co). Opsional (fallback ke OAuth redirect jika kosong).
NEXT_PUBLIC_GOOGLE_CLIENT_ID="[YOUR-GOOGLE-CLIENT-ID].apps.googleusercontent.com"
# ==========================================
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Service role key (Server-only for administrative tasks)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
