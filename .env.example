# ==========================================
# BIJI CORP - ENVIRONMENT CONFIGURATION
# ==========================================

# Data Source: "prisma" (production cloud DB) or "mock" (in-memory demo)
DATA_SOURCE="prisma"

# App Public URL
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# ==========================================
# DATABASE (PostgreSQL - Supabase / Neon)
# ==========================================
# Transaction pooler connection string (port 6543 on Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct database connection string for migrations (port 5432 on Supabase)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional: Throwaway database for contract tests (must end with _test)
# TEST_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@localhost:5432/biji_test"

# ==========================================
# MIDTRANS PAYMENT GATEWAY
# ==========================================
# Midtrans Server Key (Keep secret! Never prefix with NEXT_PUBLIC_)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxx"

# Midtrans Client Key (Public for Snap.js popup checkout)
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxx"

# Set "true" for production, "false" for sandbox
MIDTRANS_IS_PRODUCTION="false"

# ==========================================
# SUPABASE (Storage & Auth)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Service role key (Server-only for administrative tasks)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
