// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum Tier {
  free
  growth
  business
}

enum ListingStatus {
  active
  draft
  archived
  suspended
}

enum SubscriptionStatus {
  active
  past_due
  canceled
}

enum PaymentType {
  subscription
  boost
  verification
}

enum PaymentStatus {
  paid
  pending
  failed
}

enum EventType {
  impression
  view
  contact_click
}

enum VerificationStatus {
  pending
  approved
  rejected
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?
  role          Role           @default(BUYER)
  suspendedAt   DateTime?      @map("suspended_at")
  createdAt     DateTime       @default(now())
  sellerProfile SellerProfile?
  orders        Order[]        @relation("UserOrders")
  reviews       Review[]
  addresses     UserAddress[]

  @@map("users")
}

model SellerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  slug               String             @unique
  province           String
  city               String
  address            String
  whatsappNumber     String
  bio                String?
  avatarUrl          String?
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(pending)
  /// Cached plan tier. The effective tier is derived from subscriptions at read time.
  tier               Tier               @default(free)
  suspendedAt        DateTime?          @map("suspended_at")
  bankUpdatedAt      DateTime?          @map("bank_updated_at")
  kycDocumentUrl     String?            @map("kyc_document_url")
  kycSubmittedAt     DateTime?          @map("kyc_submitted_at")
  createdAt          DateTime           @default(now())

  listings      Listing[]
  subscriptions Subscription[]
  payments      Payment[]
  orders        Order[]

  @@map("seller_profiles")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  listings    Listing[]

  @@map("categories")
}

model Listing {
  id          String        @id @default(uuid())
  slug        String        @unique
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  title       String
  description String?
  price       Decimal       @db.Decimal(14, 2)
  unit        String
  minOrderQty Int           @default(1)
  stock       Int           @default(100)
  status      ListingStatus @default(draft)
  isBoosted   Boolean       @default(false)
  boostUntil  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasteProfile TasteProfile?
  images       ListingImage[]
  events       AnalyticsEvent[]
  inquiries    Inquiry[]
  payments     Payment[]
  orders       Order[]
  orderItems   OrderItem[]
  reviews      Review[]

  @@index([status, createdAt])
  @@index([sellerId])
  @@index([categoryId])
  @@index([isBoosted, boostUntil])
  @@map("listings")
}

model TasteProfile {
  id              String   @id @default(uuid())
  listingId       String   @unique
  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  originRegion    String
  cropYear        String?
  moistureContent Decimal? @db.Decimal(4, 2)
  /// Wash | Natural | Honey | Wet Hulled | Anaerobic (validated in listingSchema, kept open for new methods)
  processMethod   String
  /// Light | Medium-Light | Medium | Medium-Dark | Dark
  roastLevel      String
  flavorNotes     String
  acidityScore    Decimal  @db.Decimal(3, 1)
  bodyScore       Decimal  @db.Decimal(3, 1)
  sweetnessScore  Decimal? @db.Decimal(3, 1)
  aromaScore      Decimal? @db.Decimal(3, 1)
  aftertasteScore Decimal? @db.Decimal(3, 1)
  cuppingScore    Decimal? @map("cupping_score") @db.Decimal(4, 2)
  altitude        String?
  roastDate       DateTime

  @@index([originRegion])
  @@map("taste_profiles")
}

model ListingImage {
  id        String  @id @default(uuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@index([listingId, sortOrder])
  @@map("listing_images")
}

model Subscription {
  id                String             @id @default(uuid())
  sellerId          String
  seller            SellerProfile      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  tier              Tier
  status            SubscriptionStatus @default(active)
  startedAt         DateTime
  expiresAt         DateTime
  cancelAtPeriodEnd Boolean            @default(false)
  payments          Payment[]

  @@index([sellerId, status])
  @@map("subscriptions")
}

model Payment {
  id              String        @id @default(uuid())
  sellerId        String
  seller          SellerProfile @relation(fields: [sellerId], references: [id])
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  listingId       String?
  listing         Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  type            PaymentType
  /// 0 for a boost activated with a free monthly credit.
  amount          Decimal       @db.Decimal(14, 2)
  status          PaymentStatus @default(pending)
  midtransOrderId String        @unique
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([sellerId, createdAt])
  @@map("payments")
}

model AnalyticsEvent {
  id        String    @id @default(uuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  eventType EventType
  /// Anonymous per-browser-session id used for de-duplication and rate limiting.
  sessionId String?
  createdAt DateTime  @default(now())

  @@index([listingId, createdAt])
  @@index([sessionId, createdAt])
  @@map("analytics_events")
}

model Inquiry {
  id           String   @id @default(uuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerName    String
  buyerContact String
  quantity     String
  message      String
  createdAt    DateTime @default(now())

  @@index([listingId, createdAt])
  @@map("inquiries")
}

model CoffeeOrigin {
  id            String   @id @default(uuid())
  name          String   @unique
  country       String
  islandOrState String?
  minAltitude   Int?
  maxAltitude   Int?
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([country])
  @@map("coffee_origins")
}

enum OrderStatus {
  pending_payment
  paid
  shipped
  completed
  canceled
  disputed
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique @map("order_number")
  buyerId         String?       @map("buyer_id")
  buyer           User?         @relation("UserOrders", fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName       String        @map("buyer_name")
  buyerEmail      String        @map("buyer_email")
  buyerPhone      String        @map("buyer_phone")
  buyerAddress    String        @map("buyer_address")
  buyerCity       String        @map("buyer_city")
  sellerId        String        @map("seller_id")
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  listingId       String        @map("listing_id")
  listing         Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  quantity        Int           @default(1)
  itemPrice       Decimal       @map("item_price") @db.Decimal(14, 2)
  subtotal        Decimal       @db.Decimal(14, 2)
  shippingCost    Decimal       @default(0) @map("shipping_cost") @db.Decimal(14, 2)
  serviceFee      Decimal       @default(1500) @map("service_fee") @db.Decimal(14, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(14, 2)
  shippingCourier String?       @map("shipping_courier")
  trackingNumber  String?       @map("tracking_number")
  status          OrderStatus   @default(pending_payment)
  snapToken       String?       @map("snap_token")
  midtransOrderId String?       @unique @map("midtrans_order_id")
  paymentProvider String        @default("midtrans") @map("payment_provider")
  accessToken     String?       @map("access_token")
  idempotencyKey  String?       @unique @map("idempotency_key")
  notes              String?
  disputeReason      String?       @map("dispute_reason")
  disputeEvidenceUrl String?       @map("dispute_evidence_url")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  items   OrderItem[]
  reviews Review[]
  refunds Refund[]

  @@index([sellerId])
  @@index([buyerEmail])
  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  title     String
  price     Decimal  @db.Decimal(14, 2)
  quantity  Int      @default(1)
  unit      String   @default("250g")
  grindSize String?  @map("grind_size")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([listingId])
  @@map("order_items")
}

model Review {
  id        String   @id @default(uuid())
  orderId   String?  @map("order_id")
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String?  @map("buyer_id")
  buyer     User?    @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName String   @map("buyer_name")
  rating    Int
  comment   String?
  imageUrl  String?  @map("image_url")
  sellerReply     String?   @map("seller_reply")
  sellerRepliedAt DateTime? @map("seller_replied_at")
  isReported      Boolean   @default(false) @map("is_reported")
  reportReason    String?   @map("report_reason")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([listingId])
  @@index([orderId])
  @@unique([orderId, listingId])
  @@map("reviews")
}

model UserAddress {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("Utama")
  recipientName String   @map("recipient_name")
  phone         String
  streetAddress String   @map("street_address")
  city          String
  province      String
  postalCode    String?  @map("postal_code")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_addresses")
}

model Refund {
  id          String   @id @default(uuid())
  orderId     String   @unique @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Int
  reason      String
  status      String
  providerRef String?  @map("provider_ref")
  createdBy     String?  @map("created_by")
  attempts      Int      @default(0)
  failureReason String?  @map("failure_reason")
  resolvedBy    String?  @map("resolved_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("refunds")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actorRole  String   @map("actor_role")
  action     String
  targetId   String?  @map("target_id")
  targetType String?  @map("target_type")
  details    String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model WebhookEvent {
  eventId     String   @id @map("event_id")
  provider    String   @default("midtrans")
  orderRef    String?  @map("order_ref")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([orderRef])
  @@map("webhook_events")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   @default("system")
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}
